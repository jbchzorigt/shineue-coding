{
  "name": "coding-ibdp-cs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "script": "tsx --env-file=.env.local --conditions=react-server",
    "script:prod": "tsx --env-file=.env.vercel-prod --conditions=react-server",
    "db:up": "docker compose --env-file .env.local up -d --wait",
    "piston:setup": "tsx --env-file=.env.local scripts/piston-setup.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed": "npm run script -- scripts/import-content.ts && npm run script -- scripts/seed-challenges.ts && npm run script -- scripts/seed-data-analyst.ts && npm run script -- scripts/seed-logic.ts",
    "test": "tsx --env-file=.env.local scripts/migrate.ts --test && tsx --env-file=.env.local --conditions=react-server --test --test-concurrency=1 src/lib/**/*.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@mdx-js/mdx": "^3.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/blob": "^2.8.0",
    "@xyflow/react": "^12.12.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "next-mdx-remote": "^6.0.0",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.12.1",
    "rehype-pretty-code": "^0.14.4",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.13.0",
    "sharp": "^0.34.5",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
